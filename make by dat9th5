local CONFIG = {
    DEFAULT_FOV  = 120,
    MIN_FOV      = 60,
    MAX_FOV      = 120,
    SMOOTH       = true,
    SMOOTH_TIME  = 0.25,
    
    AIM_ENABLED     = false,
